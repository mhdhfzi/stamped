# Firebase — needed for sharing trips, group chat and shared expenses.
# Copy this file to `.env` and fill in the values from:
#   Firebase console → Project settings → General → Your apps → Web app → SDK setup and configuration → Config
# These are public client settings (not secrets); access is protected by firestore.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Local testing without a real project: run `npm run emulators` and set this to true.
VITE_FIREBASE_EMULATORS=false

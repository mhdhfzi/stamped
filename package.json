{
  "name": "stamped",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Stamped — a travel photo journal. Keep your photos organised by the countries you visit.",
  "scripts": {
    "dev": "vite",
    "dev:emulators": "vite --mode emulators",
    "emulators": "npx --yes firebase-tools@13 emulators:start --only auth,firestore --project demo-stamped",
    "deploy:rules": "npx --yes firebase-tools@13 deploy --only firestore:rules",
    "deploy:web": "npm run build && npx --yes firebase-tools@13 deploy --only hosting",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "firebase": "^12.19.0",
    "firebase-admin": "^13.10.0",
    "flag-icons": "^7.5.0",
    "idb": "^8.0.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.0.3"
  }
}
